# Copy to .env locally. Never commit .env or real credentials.
# Generate a unique random secret with at least 32 characters.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_ADMIN_PASSWORD_AT_LEAST_16_CHARS
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=REPLACE_WITH_UNIQUE_STAFF_PASSWORD_AT_LEAST_16_CHARS

# Google Identity Services OAuth client ID. Required for Google login.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

# Razorpay test credentials for local/test use only. Live credentials belong in a secret manager.
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET

# Server / frontend
PORT=3000
CLIENT_URL=http://localhost:4300
